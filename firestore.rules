          incoming().keys().hasAll(['meetUrl', 'updatedAt']) &&
          incoming().keys().hasOnly(['meetUrl', 'updatedAt']) &&
          isValidLiveClassAccess(incoming());
        allow update: if isBootstrappedAdmin() && isValidId(classId) && accessDoc == 'access' &&
          isValidLiveClassAccess(incoming()) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['meetUrl', 'updatedAt']);
        allow delete: if isBootstrappedAdmin() && isValidId(classId) && accessDoc == 'access';
      }
    }

    match /class_notifications/{notifId} {
      allow get, list: if isSignedIn() && resource.data.visibility == 'public';
      allow create: if isValidId(notifId) &&
        incoming().keys().hasAll([
          'classId', 'courseId', 'groupId', 'title', 'message',
          'eventType', 'visibility', 'createdBy', 'createdAt'
        ]) &&
        incoming().keys().hasOnly([
          'classId', 'courseId', 'groupId', 'title', 'message',
          'eventType', 'visibility', 'createdBy', 'createdAt'
        ]) &&
        incoming().createdBy == request.auth.uid &&
        isValidClassNotification(incoming()) &&
        (
          isBootstrappedAdmin() ||
          (
            isSignedIn() &&
            request.auth.token.email_verified == true &&
            request.auth.token.email != null &&
            exists(/databases/$(database)/documents/live_classes/$(incoming().classId)) &&
            get(/databases/$(database)/documents/live_classes/$(incoming().classId)).data.teacherEmail == request.auth.token.email.lower()
          )
        );
      allow update: if false;
      allow delete: if isBootstrappedAdmin() && isValidId(notifId);
    }
  }
}
