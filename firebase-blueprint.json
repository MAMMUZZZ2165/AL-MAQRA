        "teacherName": { "type": "string", "description": "Teacher name." },
        "teacherEmail": { "type": "string", "description": "Teacher Google email." },
        "country": { "type": "string", "description": "Country." },
        "currentMembers": { "type": "integer", "description": "Current member count." },
        "maxMembers": { "type": "integer", "description": "Maximum capacity." },
        "level": { "type": "string", "enum": ["Beginner", "Intermediate", "Expert"], "description": "Level." },
