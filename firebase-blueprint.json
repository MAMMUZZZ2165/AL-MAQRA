        "allowStudentInvite": { "type": "boolean", "description": "Whether enrolled students may share group invite links." },
        "visibility": { "type": "string", "enum": ["public"], "description": "Public visibility for signed-in users." },
        "createdBy": { "type": "string", "description": "Admin UID." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update." }
      },
      "required": [
        "arabicTitle", "englishTitle", "subject", "track", "teacherName",
        "teacherEmail", "country", "currentMembers", "maxMembers", "level",
        "language", "allowStudentInvite", "visibility", "createdBy", "createdAt", "updatedAt"
      ]
    },
    "StudentEnrollment": {
      "title": "StudentEnrollment",
      "description": "Platform-wide student enrollment directory for admin management & live class access gating.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Student UID." },
        "userName": { "type": "string", "description": "Student name." },
        "userEmail": { "type": "string", "description": "Student email." },
        "targetId": { "type": "string", "description": "Course or group ID." },
        "targetType": { "type": "string", "enum": ["course", "group"], "description": "Course or group." },
        "title": { "type": "string", "description": "Course or group title." },
        "arabicTitle": { "type": "string", "description": "Arabic title." },
        "track": { "type": "string", "description": "Track." },
        "mode": { "type": "string", "enum": ["Online", "Offline"], "description": "Delivery mode." },
        "level": { "type": "string", "enum": ["Beginner", "Intermediate", "Expert"], "description": "Level." },
        "language": { "type": "string", "description": "Language." },
        "teacherName": { "type": "string", "description": "Assigned teacher name." },
        "teacherCountry": { "type": "string", "description": "Teacher country." },
        "feePlan": { "type": "string", "description": "Selected fee plan summary." },
        "paymentId": { "type": "string", "description": "Associated payment orderId or free_trial." },
        "paymentStatus": { "type": "string", "enum": ["free_trial", "verified", "pending", "refunded"], "description": "Payment verification status." },
        "enrollmentStatus": { "type": "string", "enum": ["pending_assessment", "active", "completed", "cancelled"], "description": "Lifecycle status." },
        "assignedGroupId": { "type": "string", "description": "Assigned group ID if allocated." },
        "completedSessions": { "type": "integer", "description": "Completed sessions." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update." }
      },
      "required": [
        "userId", "userName", "userEmail", "targetId", "targetType", "title",
        "arabicTitle", "track", "mode", "level", "language", "teacherName",
        "teacherCountry", "feePlan", "paymentId", "paymentStatus",
        "enrollmentStatus", "assignedGroupId", "completedSessions", "createdAt", "updatedAt"
      ]
    },
    "LiveClass": {
      "title": "LiveClass",
      "description": "Scheduled live Qur'an/Tajweed session linked to course, group, teacher, and Google Meet.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Live class title." },
        "courseId": { "type": "string", "description": "Linked course ID." },
        "courseTitle": { "type": "string", "description": "Linked course title." },
        "groupId": { "type": "string", "description": "Assigned student group ID." },
        "groupTitle": { "type": "string", "description": "Assigned group title." },
        "teacherName": { "type": "string", "description": "Assigned teacher display name." },
        "teacherEmail": { "type": "string", "description": "Lowercase teacher Google email for teacher dashboard access." },
        "scheduledEpochMs": { "type": "integer", "description": "Start timestamp in UTC epoch milliseconds." },
        "dateTimeLabel": { "type": "string", "description": "Formatted date and time label." },
        "durationMinutes": { "type": "integer", "description": "Class duration in minutes." },
        "description": { "type": "string", "description": "Agenda and Tajweed notes." },
        "meetSource": { "type": "string", "enum": ["google_calendar_api", "manual"], "description": "How the Meet link was created." },
        "calendarEventId": { "type": "string", "description": "Google Calendar event ID when auto-generated." },
        "status": { "type": "string", "enum": ["scheduled", "completed", "cancelled"], "description": "Class schedule state." },
        "lastUpdateNote": { "type": "string", "description": "Latest announcement or teacher note." },
        "visibility": { "type": "string", "enum": ["public"], "description": "Schedule metadata visibility for signed-in users." },
        "createdBy": { "type": "string", "description": "Admin UID." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update." }
      },
      "required": [
        "title", "courseId", "courseTitle", "groupId", "groupTitle",
        "teacherName", "teacherEmail", "scheduledEpochMs", "dateTimeLabel",
        "durationMinutes", "description", "meetSource", "calendarEventId",
        "status", "lastUpdateNote", "visibility", "createdBy", "createdAt", "updatedAt"
      ]
    },
    "LiveClassAccess": {
      "title": "LiveClassAccess",
      "description": "Access-gated Google Meet join URL accessible only to enrolled course/group students, assigned teacher, or admin.",
      "type": "object",
      "properties": {
        "meetUrl": { "type": "string", "description": "Google Meet URI." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update." }
      },
      "required": ["meetUrl", "updatedAt"]
    },
    "ClassNotification": {
      "title": "ClassNotification",
      "description": "Schedule alerts when a live class is scheduled, rescheduled, cancelled, or updated by teacher.",
      "type": "object",
      "properties": {
        "classId": { "type": "string", "description": "Related live class ID." },
        "courseId": { "type": "string", "description": "Related course ID." },
        "groupId": { "type": "string", "description": "Related group ID." },
        "title": { "type": "string", "description": "Alert title." },
        "message": { "type": "string", "description": "Alert message body." },
        "eventType": { "type": "string", "enum": ["scheduled", "rescheduled", "cancelled", "reminder", "teacher_update"], "description": "Notification type." },
        "visibility": { "type": "string", "enum": ["public"], "description": "Visibility." },
        "createdBy": { "type": "string", "description": "Creator UID." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation." }
      },
      "required": ["classId", "courseId", "groupId", "title", "message", "eventType", "visibility", "createdBy", "createdAt"]
    }
  },
